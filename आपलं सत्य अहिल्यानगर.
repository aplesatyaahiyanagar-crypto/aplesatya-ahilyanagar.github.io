.breaking{
    background:#fff;
    margin:15px 0;
    border:1px solid #ddd;
    display:flex;
    align-items:center;
    overflow:hidden;
}

.breaking-title{
    background:#d71920;
    color:white;
    padding:9px 15px;
    font-weight:bold;
    white-space:nowrap;
}

.breaking-text{
    padding:8px 15px;
    white-space:nowrap;
    animation:scroll 18s linear infinite;
}

@keyframes scroll{
    from{transform:translateX(100%);}
    to{transform:translateX(-100%);}
}

/* MAIN GRID */
.main-grid{
    display:grid;
    grid-template-columns:2fr 1fr;
    gap:20px;
}

